#include <stdio.h>

int main()
{
    int a[50], n, target;
    int low, high, mid;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter sorted elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter target: ");
    scanf("%d", &target);

    low = 0;
    high = n - 1;

    while (low <= high)
    {
        mid = (low + high) / 2;

        if (a[mid] == target)
        {
            printf("Target found at index %d", mid);
            return 0;
        }
        else if (target < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    printf("Target not found");

    return 0;
}
