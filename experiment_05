#include <stdio.h>

#define SIZE 5

int stack[SIZE];
int top = -1;

int queue[SIZE];
int front = 0;
int rear = -1;

void push() {
    int val;
    if (top == SIZE - 1) {
        printf("Stack is Full!\n");
    } else {
        printf("Enter value to push: ");
        scanf("%d", &val);
        top++;
        stack[top] = val;
        printf("Pushed %d. TOP index is now: %d\n", val, top);
    }
}

void pop() {
    if (top == -1) {
        printf("Stack is Empty!\n");
    } else {
        printf("Popped value: %d\n", stack[top]);
        top--;
        printf("TOP index is now: %d\n", top);
    }
}

void displayStack() {
    if (top == -1) {
        printf("Stack is Empty!\n");
    } else {
        printf("Stack elements (from top to bottom):\n");
        for (int i = top; i >= 0; i--) {
            printf("%d\n", stack[i]);
        }
        printf("TOP position index: %d\n", top);
    }
}

void enqueue() {
    int val;
    if (rear == SIZE - 1) {
        printf("Queue is Full!\n");
    } else {
        printf("Enter value to insert in Queue: ");
        scanf("%d", &val);
        rear++;
        queue[rear] = val;
        printf("Inserted %d. FRONT index: %d, REAR index: %d\n", val, front, rear);
    }
}

void dequeue() {
    if (front > rear) {
        printf("Queue is Empty!\n");
    } else {
        printf("Deleted value from Queue: %d\n", queue[front]);
        front++;
    }
}

void displayQueue() {
    if (front > rear) {
        printf("Queue is Empty!\n");
    } else {
        printf("Queue elements:\n");
        for (int i = front; i <= rear; i++) {
            printf("%d ", queue[i]);
        }
        printf("\nFRONT index: %d, REAR index: %d\n", front, rear);
    }
}

int main() {
    int choice;

    while (1) {
        printf("\nSELECT OPERATION: \n");
        printf("1. Stack: PUSH\n");
        printf("2. Stack: POP\n");
        printf("3. Stack: DISPLAY (with TOP position)\n");
        printf("4. Queue: ENQUEUE (Insert)\n");
        printf("5. Queue: DEQUEUE (Delete)\n");
        printf("6. Queue: DISPLAY\n");
        printf("7. Exit\n");
        printf("Enter your choice (1-7): ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                push();
                break;
            case 2:
                pop();
                break;
            case 3:
                displayStack();
                break;
            case 4:
                enqueue();
                break;
            case 5:
                dequeue();
                break;
            case 6:
                displayQueue();
                break;
            case 7:
                printf("Exiting program...\n");
                return 0;
            default:
                printf("Invalid choice! Please select 1 to 7.\n");
        }
    }

    return 0;
}
