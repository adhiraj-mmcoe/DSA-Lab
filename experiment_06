#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *next;
};

struct node *top = NULL;

int main() {
    int choice, value;
    struct node *newnode, *temp;

    while (choice != 4) {
        printf("\n1.Push\n2.Pop\n3.Display\n4.Exit\n");
        scanf("%d", &choice);

        switch (choice) {

        case 1:
            newnode = malloc(sizeof(struct node));
            printf("Enter value: ");
            scanf("%d", &value);

            newnode->data = value;
            newnode->next = top;
            top = newnode;
            break;

        case 2:
            if (top == NULL)
                printf("Stack is empty");
            else {
                printf("Deleted: %d", top->data);
                temp = top;
                top = top->next;
                free(temp);
            }
            break;

        case 3:
            temp = top;
            while (temp != NULL) {
                printf("%d ", temp->data);
                temp = temp->next;
            }
            break;

        case 4:
            printf("Exit");
            break;
        }
    }

    return 0;
}
